  "properties": {
    "title": "Global Fire Emissions Indicators, Grids: 1997-2015",
    "description": "The Global Fire Emissions Indicators, Grids: 1997-2015 contain a time-series of rasters from 1997 to 2015 for total area burned (hectares) and total carbon content (tons). The annual total area burned raster is the sum of monthly rasters, which are products of the Cell Area and Burn Fraction (fraction of the cell area burned in the month). There are two groups of total carbon content (TCC) rasters, annual totals for all fire types and annual totals for each of six fire types which include Agricultural, Boreal, Tropical Deforestation, Peat, Savanna, and Temperate forest fires. The annual TCC raster for all fire types is the sum of monthly carbon emission rasters. The annual TCC raster for each fire type is the product of Dry Matter, Burn Fraction, and Fire Type Contribution.",
    "datetime": "2018-02-23T00:00:00Z",
    "start_datetime": "1997-01-01T00:00:00.000Z",
    "end_datetime": "2015-12-31T00:00:00.000Z",
