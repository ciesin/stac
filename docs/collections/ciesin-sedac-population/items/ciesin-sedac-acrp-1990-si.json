  "properties": {
    "title": "Archive of Census Related Products (ACRP): 1990 Street Intersections",
    "description": "The 1990 Street Intersections portion of the Archive of Census Related Products (ACRP) contains the latitude and longitude of street intersections for each county in the United States. The data includes the names of both streets that intersect, as well as the location and unique node number for streets which frequently intersect each other. This portion of the ACRP is produced by the Center for International Earth Science Information Network (CIESIN).",
    "datetime": "1996-12-31T00:00:00Z",
    "license": "CC-BY-4.0",
